# Kopieren nach .env (bzw. in Portainer unter "Environment variables" eintragen).

# Pflicht beim ersten Start: Zugangsdaten für den ersten Account. Danach kann
# das Passwort im Dashboard unter "Einstellungen" geändert werden.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-eigenes-passwort-setzen

# Optional: anderer Port, falls 5030 auf dem NAS belegt ist.
DASHBOARD_PORT=5030

# Optional: absoluter Pfad in einem Shared Folder für direkten Zugriff auf die
# SQLite-Datei (Snapshots/Backups). Ordner vorher anlegen (mkdir -p).
DATA_PATH=/volume2/docker/gear-watcher/data

# Optional: true, wenn nur per HTTPS-Reverse-Proxy erreichbar.
SECURE_COOKIES=false
